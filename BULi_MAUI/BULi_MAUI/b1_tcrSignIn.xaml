<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BULi_MAUI.b1_tcrSignIn"
             Shell.NavBarIsVisible="False">

    <!-- Consistent Rich Navy Blue Gradient Background -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#050B14" Offset="0.0" />
            <GradientStop Color="#0D1B2A" Offset="0.5" />
            <GradientStop Color="#3E2723" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <VerticalStackLayout VerticalOptions="Center" 
                         HorizontalOptions="Center" 
                         Padding="20">

        <!-- Main Card Container -->
        <Border StrokeShape="RoundRectangle 24"
                BackgroundColor="#991E3F66" 
                WidthRequest="350"
                Padding="25, 30"
                StrokeThickness="0">

            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="0.4"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="18">

                <!-- Rounded & Bordered Teacher Avatar Container -->
                <Border StrokeShape="RoundRectangle 16"
                        BackgroundColor="#F4C430"
                        WidthRequest="80"
                        HeightRequest="80"
                        HorizontalOptions="Center"
                        StrokeThickness="2"
                        Stroke="White"
                        Padding="5">

                    <Image Source="fcr_icon.png" 
                           Aspect="AspectFill"
                           HeightRequest="85"
                           WidthRequest="85"
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" />
                </Border>

                <!-- Titles -->
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="Sign In Account" 
                           TextColor="White" 
                           FontSize="22" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center"
                           FontFamily="Montserrat"/>

                    <Label Text="Faculty Access" 
                           TextColor="#B0C4DE" 
                           FontSize="14" 
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- INPUT FIELDS SECTION -->
                <VerticalStackLayout Spacing="14" Margin="0, 5, 0, 0">

                    <!-- Username Field -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Username:" TextColor="WhiteSmoke" FontSize="13" />
                        <Border StrokeShape="RoundRectangle 22"
                                BackgroundColor="#264D7A"
                                StrokeThickness="0"
                                HeightRequest="45"
                                Padding="15, 0">
                            <Entry x:Name="txtUsername" 
                                   Placeholder="Enter username" 
                                   PlaceholderColor="#A0AAB0"
                                   TextColor="White" 
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"
                                   ClearButtonVisibility="WhileEditing" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password Field -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Password:" TextColor="WhiteSmoke" FontSize="13" />
                        <Border StrokeShape="RoundRectangle 22"
                                BackgroundColor="#264D7A"
                                StrokeThickness="0"
                                HeightRequest="45"
                                Padding="15, 0">
                            <Entry x:Name="txtPassword" 
                                   Placeholder="Enter password" 
                                   PlaceholderColor="#A0AAB0"
                                   TextColor="White" 
                                   BackgroundColor="Transparent"
                                   IsPassword="True"
                                   VerticalOptions="Center"
                                   ClearButtonVisibility="WhileEditing" />
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <!-- ENTER BUTTON -->
                <Button x:Name="btnEnter" 
                        Text="Enter" 
                        Clicked="OnEnterClicked"
                        BackgroundColor="#F4C430" 
                        TextColor="#111111" 
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="48"
                        Margin="0, 10, 0, 0" />

            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>
</ContentPage>