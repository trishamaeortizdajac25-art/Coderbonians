<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sp="clr-namespace:ScottPlot.Maui;assembly=ScottPlot.Maui"
             x:Class="BULi_MAUI.e1_Graphs"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#050B14" Offset="0.0" />
            <GradientStop Color="#0D1B2A" Offset="0.5" />
            <GradientStop Color="#3E2723" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, *, Auto" Padding="18, 24, 18, 18" RowSpacing="12">

        <!-- HEADER & TOP CHART SWITCH BUTTONS -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Label Text="Student Analytics" TextColor="White" FontSize="22" FontAttributes="Bold" />

            <HorizontalStackLayout Spacing="8">
                <Button x:Name="btnProgramChart"
                        Text="By Program"
                        Clicked="OnShowProgramChartClicked"
                        BackgroundColor="#FFA500"
                        TextColor="#0D1B2A"
                        FontAttributes="Bold"
                        FontSize="12"
                        CornerRadius="10"
                        HeightRequest="36"
                        Padding="12,0" />

                <Button x:Name="btnYearChart"
                        Text="Year Level"
                        Clicked="OnShowYearChartClicked"
                        BackgroundColor="#15263A"
                        TextColor="White"
                        BorderColor="#22364D"
                        BorderWidth="1"
                        FontAttributes="Bold"
                        FontSize="12"
                        CornerRadius="10"
                        HeightRequest="36"
                        Padding="12,0" />

                <Button x:Name="btnRefreshChart"
                        Text="Refresh"
                        Clicked="OnRefreshChartClicked"
                        BackgroundColor="#15263A"
                        TextColor="#87CEEB"
                        BorderColor="#22364D"
                        BorderWidth="1"
                        FontAttributes="Bold"
                        FontSize="12"
                        CornerRadius="10"
                        HeightRequest="36"
                        Padding="12,0" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- SCOTTPLOT CARD (UNCONNECTED UI SHELL) -->
        <Border Grid.Row="1"
                BackgroundColor="#0D1B2A"
                Stroke="#22364D"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                Padding="12">
            <Grid RowDefinitions="Auto, *">
                <Label x:Name="lblChartTitle"
                       Grid.Row="0"
                       Text="Enrolled Students per Program Distribution"
                       TextColor="White"
                       FontSize="14"
                       FontAttributes="Bold"
                       LineBreakMode="WordWrap"
                       Margin="4,0,4,8" />

                <sp:MauiPlot x:Name="analyticsPlot"
                             Grid.Row="1"
                             BackgroundColor="#0D1B2A" />
            </Grid>
        </Border>

        <!-- BOTTOM-RIGHT EXPORT BUTTON -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto">
            <Button x:Name="btnExportChart"
                    Grid.Column="1"
                    Text="Export"
                    Clicked="OnExportClicked"
                    BackgroundColor="#FFA500"
                    TextColor="#0D1B2A"
                    FontAttributes="Bold"
                    FontSize="13"
                    CornerRadius="12"
                    HeightRequest="40"
                    Padding="18,0" />
        </Grid>

    </Grid>
</ContentPage>